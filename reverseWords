class Solution {
    public String reverseWords(String s) {

        String result = "";
        String word = "";

        for (int i = 0; i < s.length(); i++) {

            if (s.charAt(i) != ' ') {
                word = s.charAt(i) + word;
            } else {
                result = result + word + " ";
                word = "";
            }
        }

        result = result + word;

        return result;
    }
}
