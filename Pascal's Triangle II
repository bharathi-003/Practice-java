import java.util.*;

class Solution {
    public List<Integer> getRow(int rowIndex) {

        List<Integer> res = new ArrayList<>();

        long prev = 1;

        res.add(1);

        for (int k = 1; k <= rowIndex; k++) {

            long next = prev * (rowIndex - k + 1) / k;

            res.add((int) next);

            prev = next;
        }

        return res;
    }
}
