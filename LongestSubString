class Solution {
    public int longestSubstring(String s, int k) {

        int max = 0;

        for (int i = 0; i < s.length(); i++) {

            int[] count = new int[26];

            for (int j = i; j < s.length(); j++) {

                char ch = s.charAt(j);

                count[ch - 'a']++;

                boolean valid = true;

                for (int x = 0; x < 26; x++) {

                    if (count[x] > 0 && count[x] < k) {
                        valid = false;
                    }
                }

                if (valid) {
                    int length = j - i + 1;

                    if (length > max) {
                        max = length;
                    }
                }
            }
        }

        return max;
    }
}
