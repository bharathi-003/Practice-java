class Solution {
    public boolean canConstruct(String s, int k) {
       if(k>s.length()){
        return false;
       }
       int[] count=new int[26];
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            count[ch -'a']++;
        }
        int odd=0;
        for(int i=0;i<26;i++){
            if(count[i]%2==1){
                odd++;
            }
        }
        if(odd<=k){
            return true;
        }else{
            return false;
        }
    }
}
