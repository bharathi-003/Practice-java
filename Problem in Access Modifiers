

class person{
    public String name;
    protected int age;
    private int Securitynumber;
    String address;

    person(String name,int age,int sn,String add) {
        this.name=name;
        this.age=age;
        this.Securitynumber=sn;
        this.address=add;
    }
    void show(){
        Securitynumber=12345678;
        System.out.println(Securitynumber);
    }
    
}

class Employee extends person{

     Employee(String name,int age,int sn,String add) {
        super(name,age,sn,add);
        System.out.println("Hello Employee");
    }
        
}


