class Solution {
    public String multiply(String num1, String num2) {
        int n1=0;
        int n2=0;
        for(int i=0;i<num1.length();i++){
            n1=n1*10+(num1.charAt(i)-'0');
        }
        for(int i=0;i<num2.length();i++){
            n2=n2*10+(num2.charAt(i)-'0');
        }
        int result=n1*n2;
       return String.valueOf(result);

    }
}
