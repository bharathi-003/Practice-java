class Solution {
    public int minOperations(int[] nums, int x) {

        int n = nums.length;
        int tot = 0;

        for (int num : nums) {
            tot += num;
        }

        int target = tot - x;

        if (target < 0) return -1;
        if (target == 0) return n;

        int left = 0;
        int sum = 0;
        int max_sum = -1;

        for (int right = 0; right < n; right++) {

            sum += nums[right];

            while (left <= right && sum > target) {
                sum -= nums[left];
                left++;
            }

            if (sum == target) {
                max_sum = Math.max(max_sum, right - left + 1);
            }
        }

        if (max_sum == -1) {
            return -1;
        }

        return n - max_sum;
    }
}
