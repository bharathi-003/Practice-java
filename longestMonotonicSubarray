class Solution {
    public int longestMonotonicSubarray(int[] nums) {
        int n=nums.length;
        int max=1;
        int up=1;
        int down=1;
        for(int i=1;i<n;i++){
            if(nums[i]<nums[i-1]){
                down=1;
                up++;
            }
            else if(nums[i]>nums[i-1]){
                up=1;
                down++;
            }
            else{
                up=1;
                down=1;
            }
            max=Math.max(up,Math.max(down,max));
        }
        return max;
    }
}
