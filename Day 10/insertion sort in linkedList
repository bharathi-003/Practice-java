class Solution {
    public ListNode insertionSortList(ListNode head) {

        if (head == null) return null;

        int n = 0;
        ListNode temp = head;
        while (temp != null) {
            n++;
            temp = temp.next;
        }

     
        int[] arr = new int[n];
        temp = head;
        for (int i = 0; i < n; i++) {
            arr[i] = temp.val;
            temp = temp.next;
        }

        
        for (int i = 1; i < arr.length; i++) {
            int key = arr[i];
            int j = i - 1;

            while (j >= 0 && arr[j] > key) {
                arr[j + 1] = arr[j];
                j--;
            }

            arr[j + 1] = key;
        }

        
        temp = head;
        for (int i = 0; i < n; i++) {
            temp.val = arr[i];
            temp = temp.next;
        }

        return head;
    }
}
