
class Solution {
    public String convert(String s, int numRows) {

        if (numRows == 1) {
            return s;
        }

        String a = "";

        for (int i = 0; i < numRows; i++) {

            for (int j = i; j < s.length(); j += 2 * (numRows - 1)) {

                a += s.charAt(j);

                if (i > 0 && i < numRows - 1 &&
                    j + 2 * (numRows - 1) - 2 * i < s.length()) {

                    a += s.charAt(j + 2 * (numRows - 1) - 2 * i);
                }
            }
        }

        return a;
    }
}
