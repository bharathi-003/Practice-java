import java.util.*;

class Main {
    public static void main(String[] args) {
       Scanner sc=new Scanner(System.in);
       String s=sc.next();
       int left=0;
        int right=s.length()-1;
        if(left<right){
            if(s.charAt(left)!= s.charAt(right)){
                System.out.println("not palindrome");
                return;
            }
            left++;
            right--;

        }
System.out.println("palindrome");
        
       }
    }
