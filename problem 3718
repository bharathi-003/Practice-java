class Solution {
    public int missingMultiple(int[] nums, int k) {
        boolean[] ans=new boolean[101];
        for(int i=0;i<nums.length;i++)
        {
            if(nums[i]%k==0)
            {
                ans[nums[i]/k]=true;
            }
        }
        for(int i=1;i<=100;i++)
        {
            if(!ans[i])
            {
                return k*i;
            }
        }
        return 101*k;
    }
}
